# Copy this file to .env.local and fill in what you need.

# --- Local model (powers the /tools teacher toolkit) ---
# Any OpenAI-compatible server works. Defaults to Ollama on this machine.
#   Ollama:      http://localhost:11434/v1
#   LM Studio:   http://localhost:1234/v1
#   llama.cpp:   http://localhost:8080/v1   (llama-server)
#   vLLM:        http://localhost:8000/v1
LOCAL_LLM_BASE_URL=http://localhost:11434/v1
# Model name exactly as your server reports it (`ollama list`).
# Leave blank to use the first model the server has loaded.
LOCAL_LLM_MODEL=
# Only needed if your server requires a key (vLLM --api-key, a proxy, etc.).
LOCAL_LLM_API_KEY=
# Large models on modest hardware can be slow. Milliseconds.
LOCAL_LLM_TIMEOUT_MS=300000

# --- Gemini (only used by the E2C /admin/content-assistant page) ---
# Get a free Gemini API key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
